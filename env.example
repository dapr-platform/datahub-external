# 服务端口配置
LISTEN_PORT=8180
BASE_CONTEXT=/swagger/datahub-external

# API认证密钥
API_KEY=your-api-key-here

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=datahub_external
DB_SSLMODE=disable
# 数据库日志级别: silent(不打印), error(仅错误), warn(警告+错误), info(所有SQL)
DB_LOG_LEVEL=warn

# 绿云接口配置
LVYUN_BASE_URL=http://your-lvyun-server:port
LVYUN_HOTEL_GROUP_CODE=YOUR_HOTEL_GROUP_CODE
LVYUN_HOTEL_CODE=YOUR_HOTEL_CODE
LVYUN_USER_CODE=your-user-code
LVYUN_PASSWORD=your-password
LVYUN_APP_KEY=YOUR_APP_KEY
LVYUN_APP_SECRET=your-app-secret

# 绿云定时调度配置（启用/禁用）
LVYUN_ENABLE_SCHEDULER=true

# 绿云定时调度CRON表达式（秒 分 时 日 月 周）
# 默认：每30分钟执行一次
LVYUN_RESERVATION_CRON=0 */30 * * * *
LVYUN_REGISTRATION_CRON=0 */30 * * * *
LVYUN_CHECKOUT_CRON=0 */30 * * * *
LVYUN_BUSINESS_REPORT_CRON=0 */30 * * * *

# 绿云查询天数配置
LVYUN_QUERY_DAYS=7
LVYUN_BUSINESS_REPORT_DAYS=1
